@using ANC25_WEBAPI_DLL
@using Microsoft.AspNetCore.Mvc.Rendering
@inject CountryCodes Countries

@{
    SelectList slcoutries = new SelectList(Countries.Codes, "code", "countryLabel");
}

@using (Html.BeginForm("NewHumanForm", "Celebrities", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    <div class="row">
        @Html.TextBox("fullname", (string)ViewBag.FullName, new { @class = "col-8", placeholder = "Celebrities Name", required = "true" })
        @Html.DropDownList("Nationality", slcoutries, new { @class = "col-4" })
    </div>

    <div class="row" style="margin-top: 10px;">
        @if (ViewBag.IsConfirmation == true)
        {
            <input type="hidden" name="filename" value="@ViewBag.FileName" />
            
            <button class="col-12" type="button" disabled style="color: black;">@ViewBag.OriginalName</button>
        }
        else
        {
            <input id="upload" name="upload" type="file" style="display:none;" accept="image/jpeg" onchange="onChange(this)" required />
            <button class="col-12" id="butupload" type="button" onclick="document.getElementById('upload').click()">Upload Photo</button>
        }
    </div>

    <div class="row" style="margin-top: 10px;">
        @if (ViewBag.IsConfirmation == true)
        {
            <button class="col-6" type="submit" formaction="/Celebrities/ConfirmHuman"> CONFIRMATION </button>
            
            <button class="col-6" type="submit" formaction="/Celebrities/CancelHuman" formnovalidate> CANCEL </button>
        }
        else
        {
            <button class="col-6" type="submit"> OK </button>
            <button class="col-6" type="button" onclick="location.href='/'"> CANCEL </button>
        }
    </div>
}

<script>
    function onChange(e)
    {
        if(e.value == '')
        {
            document.getElementById('butupload').innerText = "Upload Photo";
        }
        else{
            document.getElementById('butupload').innerText = e.value.split('\\').pop();
        }
    }
</script>