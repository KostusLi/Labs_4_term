<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.6.1 Chrome/142.0.7444.265 Electron/39.8.0 Safari/537.36">
  <diagram name="Страница-1" id="OS605jQQRsI3tT4qs9vD">
    <mxGraphModel dx="1288" dy="659" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nskinparam monochrome true\nskinparam shadowing false\nskinparam ActivityDiamondBackgroundColor white\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\n&#39; Создаем общую рамку (как на фото)\npartition \&quot;Приложение (Биржа задач)\&quot; {\n    \n    start\n    \n    :Сотрудник открывает личный\\nкабинет;\n    \n    :Переходит в раздел\\n\&quot;Биржа задач\&quot;;\n    \n    :Выбирает задачу из списка\\n(например, \&quot;Помочь с Excel\&quot;);\n    \n    :Нажимает кнопку \&quot;Взять в работу\&quot;\\nи отправляет запрос;\n    \n    if (Задача свободна в БД?) then (Да)\n        :Система закрепляет задачу\\nза исполнителем;\n        \n        :Статус задачи меняется\\nна \&quot;В процессе\&quot;;\n        \n        &#39; Начало параллельного выполнения (жирная черная линия)\n        fork\n            :Исполнитель выполняет\\nзадачу в реальности;\n            :Нажимает в приложении\\n\&quot;Готово\&quot;;\n        fork again\n            :Заказчик видит, что за\\nзадачу взялись;\n            :Ожидает результата;\n        end fork\n        &#39; Конец параллельного блока\n        \n        :Заказчик подтверждает\\nвыполнение;\n        \n        :Система начисляет коины\\nи сохраняет транзакцию;\n        \n        stop\n        \n    else (Нет)\n        :Система выводит ошибку\\n\&quot;Задача уже кем-то взята\&quot;;\n        \n        if (Обновить список?) then (Да)\n            :Приложение запрашивает\\nактуальный список из БД;\n            \n            :Повторное отображение\\nсвободных задач;\n            stop\n        else (Нет)\n            :Возврат на главный экран;\n            stop\n        endif\n    endif\n\n}\n@enduml&quot;,&quot;format&quot;:&quot;svg&quot;}" id="hMG4YFrK5feN6LXfhsMl-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
