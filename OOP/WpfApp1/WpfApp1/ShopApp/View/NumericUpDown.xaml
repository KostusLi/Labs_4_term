<UserControl x:Class="WpfApp1.ShopApp.View.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl" 
             MinHeight="30" MinWidth="100">

    <Border BorderBrush="{DynamicResource ControlBorder}" BorderThickness="1" CornerRadius="5" Background="{DynamicResource PanelBackground}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="30"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="30"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="-" FontSize="16" FontWeight="Bold" 
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}"
                    Click="BtnMinus_Click" Cursor="Hand"/>

            <TextBox Grid.Column="1" 
                     Text="{Binding Value, ElementName=RootControl, UpdateSourceTrigger=PropertyChanged}" 
                     TextAlignment="Center" VerticalContentAlignment="Center"
                     Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}"
                     FontSize="14" FontWeight="Bold"
                     
                     PreviewTextInput="TextBox_PreviewTextInput"
                     DataObject.Pasting="TextBox_Pasting"/>

            <Button Grid.Column="2" Content="+" FontSize="16" FontWeight="Bold" 
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}"
                    Click="BtnPlus_Click" Cursor="Hand"/>
        </Grid>
    </Border>
</UserControl>