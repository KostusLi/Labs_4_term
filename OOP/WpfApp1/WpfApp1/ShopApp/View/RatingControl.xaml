<UserControl x:Class="WpfApp1.ShopApp.View.RatingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl">

    <StackPanel x:Name="StarsPanel" Orientation="Horizontal" Background="Transparent" 
                MouseLeave="StarsPanel_MouseLeave">
        <TextBlock x:Name="Star1" Text="☆" FontSize="24" Foreground="#FF9800" Cursor="Hand" Tag="1"
                   MouseEnter="Star_MouseEnter" MouseLeftButtonUp="Star_Click"/>
        <TextBlock x:Name="Star2" Text="☆" FontSize="24" Foreground="#FF9800" Cursor="Hand" Tag="2"
                   MouseEnter="Star_MouseEnter" MouseLeftButtonUp="Star_Click"/>
        <TextBlock x:Name="Star3" Text="☆" FontSize="24" Foreground="#FF9800" Cursor="Hand" Tag="3"
                   MouseEnter="Star_MouseEnter" MouseLeftButtonUp="Star_Click"/>
        <TextBlock x:Name="Star4" Text="☆" FontSize="24" Foreground="#FF9800" Cursor="Hand" Tag="4"
                   MouseEnter="Star_MouseEnter" MouseLeftButtonUp="Star_Click"/>
        <TextBlock x:Name="Star5" Text="☆" FontSize="24" Foreground="#FF9800" Cursor="Hand" Tag="5"
                   MouseEnter="Star_MouseEnter" MouseLeftButtonUp="Star_Click"/>
    </StackPanel>
</UserControl>