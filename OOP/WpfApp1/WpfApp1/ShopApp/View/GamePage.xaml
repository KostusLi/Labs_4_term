<Page x:Class="WpfApp1.ShopApp.View.GamePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Мини-игра MVVM">

    <Grid Background="{DynamicResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource PanelBackground}" Padding="15" BorderBrush="{DynamicResource ControlBorder}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding GoBackCommand}" Content="🡠 Назад в магазин" 
                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryText}" Cursor="Hand" Margin="0,0,20,0" FontWeight="Bold"/>

                <TextBlock Text="Управление дронами-доставщиками (MVVM Задание)" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource PrimaryText}" Margin="0,0,20,0" VerticalAlignment="Center"/>

                <Button Command="{Binding AddDroneCommand}" Content="Сгенерировать дрона" Style="{StaticResource MainButtonStyle}" Margin="0,0,10,0"/>
                <Button Command="{Binding ClearDronesCommand}" Content="Уничтожить всех" Style="{StaticResource DangerButtonStyle}"/>
            </StackPanel>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Drones}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas Background="LightGray" ClipToBounds="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel RenderTransformOrigin="0.5, 0.5" ToolTip="{Binding Name}">

                        <StackPanel.RenderTransform>
                            <RotateTransform Angle="{Binding Angle}"/>
                        </StackPanel.RenderTransform>

                        <Grid HorizontalAlignment="Center" Width="{Binding Size}" Height="{Binding Size}">
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="5" Opacity="0.5" Color="Black"/>
                            </Grid.Effect>

                            <Ellipse Width="16" Height="16" Fill="#444" Stroke="#222" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-5,-5,0,0" Opacity="0.8"/>
                            <Ellipse Width="16" Height="16" Fill="#444" Stroke="#222" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0" Opacity="0.8"/>
                            <Ellipse Width="16" Height="16" Fill="#444" Stroke="#222" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-5,0,0,-5" Opacity="0.8"/>
                            <Ellipse Width="16" Height="16" Fill="#444" Stroke="#222" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5" Opacity="0.8"/>

                            <Ellipse Fill="{Binding DroneColor}" Stroke="White" StrokeThickness="2" Margin="5"/>

                            <Polygon Points="0,10 10,10 5,0" Fill="Red" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-15,0,0"/>

                            <Rectangle Width="20" Height="20" Fill="#8D6E63" Stroke="#5D4037" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button Command="{Binding RotateCommand}" Content="⟳" FontSize="14" FontWeight="Bold" Background="#333" Foreground="White" Padding="8,2" Cursor="Hand" BorderThickness="0"/>
                            <Button Command="{Binding MoveForwardCommand}" Content="🡡" FontSize="14" FontWeight="Bold" Background="#4CAF50" Foreground="White" Padding="8,2" Cursor="Hand" Margin="2,0" BorderThickness="0"/>
                            <Button Command="{Binding UpgradeCommand}" Content="⭐" FontSize="14" Background="#FF9800" Foreground="White" Padding="8,2" Cursor="Hand" BorderThickness="0"/>
                        </StackPanel>

                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Page>